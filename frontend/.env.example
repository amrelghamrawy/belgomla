# Copy to .env.local. Only `next dev` / a bare `next start` use these: in production Nginx sends
# /api and /sanctum to PHP-FPM before they reach Next (tasks/11-release.md).

# Where app/api and app/sanctum forward requests (the Laravel app, e.g. `php artisan serve`).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Tenant hosts are {subdomain}.TENANT_BASE_DOMAIN (matches the backend's TENANT_BASE_DOMAIN).
TENANT_BASE_DOMAIN=gomal.test
