APP_NAME=BelGomla
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=belgomla
DB_USERNAME=belgomla
DB_PASSWORD=belgomla_dev

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: true (cookies only over HTTPS). SESSION_DOMAIN stays null = host-only cookie per tenant (Tech §6)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# D61: uploads use the public disk with relative URLs, served same-origin by Nginx (prod) or Next (dev)
PUBLIC_DISK_URL=/storage
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis/predis is installed; the phpredis extension is not required
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TENANT_BASE_DOMAIN=gomal.test

# Sanctum SPA cookies: the frontend (Next.js on :3000) and the API (:8000) on every tenant host (Tech §6)
SANCTUM_STATEFUL_DOMAINS=*.gomal.test,*.gomal.test:8000,*.gomal.test:3000,*.gomalecommerce.app

# Messaging (Tech §13): log = storage/logs/messages.log, hypersender = real WhatsApp + SMS
MESSAGING_DRIVER=log
MESSAGING_WEBHOOK_SECRET=
HYPERSENDER_TOKEN=
HYPERSENDER_SMS_TOKEN=
HYPERSENDER_WHATSAPP_INSTANCE=
HYPERSENDER_SMS_INSTANCE=
HYPERSENDER_SAFE_SEND=true

# Monitoring (tasks/11, D65): platform:monitor alerts this phone over WhatsApp, sent as this tenant
MONITOR_ALERT_TENANT=
MONITOR_ALERT_PHONE=
MONITOR_REALERT_MINUTES=60
MONITOR_QUEUE_BACKLOG_MAX=50
MONITOR_DISK_MIN_FREE_PERCENT=10
MONITOR_HEARTBEAT_MAX_MINUTES=120

# D70 store WhatsApp numbers (tasks/12): wa-gateway on this machine; same token/secret as wa-gateway
WA_GATEWAY_ENABLED=false
WA_GATEWAY_URL=http://127.0.0.1:3100
WA_GATEWAY_TOKEN=
WA_GATEWAY_WEBHOOK_SECRET=
