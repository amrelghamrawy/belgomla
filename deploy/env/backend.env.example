# /etc/belgomla/backend.env (mode 640 root:belgomla), symlinked as backend/.env by provision.sh.
# Template only: real values never go into git (tasks/11). Fill every empty value before deploy.sh.
APP_NAME=BelGomla
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show  -> paste here
APP_KEY=
APP_URL=https://gomalecommerce.app
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Daily files in storage/logs, 14 days. No Sentry in V1 (D66); errors are in laravel-YYYY-MM-DD.log.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=belgomla
DB_USERNAME=belgomla
DB_PASSWORD=

# Host-only session cookie per tenant host (Tech §6): SESSION_DOMAIN stays empty.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# D64/D61: images stay on the local public disk, served by nginx at /storage, backed up nightly to S3.
FILESYSTEM_DISK=local
PUBLIC_DISK_URL=/storage

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=belgomla_

# predis/predis is installed, so the php-redis extension is not needed.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

TENANT_BASE_DOMAIN=gomalecommerce.app
SANCTUM_STATEFUL_DOMAINS=*.gomalecommerce.app

# Messaging (Tech §13). Webhooks: https://hooks.gomalecommerce.app/api/webhooks/hypersender/{whatsapp|sms}
# with the header  Authorization: <MESSAGING_WEBHOOK_SECRET>  (openssl rand -hex 32).
MESSAGING_DRIVER=hypersender
MESSAGING_WEBHOOK_SECRET=
HYPERSENDER_TOKEN=
HYPERSENDER_SMS_TOKEN=
HYPERSENDER_WHATSAPP_INSTANCE=
HYPERSENDER_SMS_INSTANCE=
HYPERSENDER_SAFE_SEND=true

# Monitoring (D65): alerts go over WhatsApp to the operator, logged under this tenant's messages.
MONITOR_ALERT_TENANT=alnoor
MONITOR_ALERT_PHONE=
MONITOR_REALERT_MINUTES=60
MONITOR_QUEUE_BACKLOG_MAX=50
MONITOR_DISK_MIN_FREE_PERCENT=10
MONITOR_HEARTBEAT_MAX_MINUTES=120
