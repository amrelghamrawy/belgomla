# /etc/belgomla/frontend.env, read by belgomla-next.service.
# In production the browser's /api, /sanctum and /storage never reach Next (nginx sends them to Laravel).
# Only the server-side listing prefetch (lib/server/store-data.ts) uses BACKEND_*: nginx's internal
# 127.0.0.1:8081 listener, which forwards to PHP-FPM with the shopper's Host.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8081
TENANT_BASE_DOMAIN=gomalecommerce.app
