# /etc/belgomla/wa-gateway.env (mode 640 root:belgomla), read by belgomla-wa-gateway.service (D70, tasks/12).
# Template only: real values never go into git. TOKEN and WEBHOOK_SECRET must equal WA_GATEWAY_TOKEN and
# WA_GATEWAY_WEBHOOK_SECRET in backend.env (openssl rand -hex 32 each). The data dir is set by the unit.
WA_GATEWAY_HOST=127.0.0.1
WA_GATEWAY_PORT=3100
WA_GATEWAY_TOKEN=
WA_GATEWAY_WEBHOOK_SECRET=

# Events go to Laravel through nginx's loopback listener, with the hooks Host so the webhook route matches.
WA_GATEWAY_WEBHOOK_URL=http://127.0.0.1:8081/api/webhooks/wa-gateway
WA_GATEWAY_WEBHOOK_HOST=hooks.belgomla.app

WA_GATEWAY_MAX_SESSIONS=50
WA_GATEWAY_SEND_PER_MINUTE=10
WA_GATEWAY_LOG_LEVEL=info
