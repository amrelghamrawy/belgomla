# /etc/belgomla/ops.env: settings for the deploy/ scripts (provision, deploy, backup, restore, monitor).
APP_USER=belgomla
APP_DIR=/srv/belgomla
BASE_DOMAIN=gomalecommerce.app
PHP_VERSION=8.5
DEPLOY_REF=main

# Tenant used by the post-deploy and monitor smoke checks.
SMOKE_TENANT=alnoor

# certbot DNS challenge (D44): plugin name of the DNS provider's snap, credentials file outside git.
DNS_PLUGIN=cloudflare
DNS_CREDENTIALS=/etc/belgomla/certbot-dns.ini
CERTBOT_EMAIL=

# pg_dump/pg_restore/psql connection; the password lives in ~belgomla/.pgpass (mode 600).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=belgomla
PGUSER=belgomla

# rclone remote (configured with `sudo -u belgomla rclone config`, stored in ~belgomla/.config/rclone/)
# followed by bucket/path. D44: the hosting provider's S3-compatible object storage.
BACKUP_REMOTE=belgomla-s3:belgomla-backups/prod
BACKUP_RETENTION_DAYS=30
